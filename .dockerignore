!frontend/vite.config.ts
!frontend/src/
!frontend/src/*.ts
!frontend/src/*.tsx
!frontend/src/*.css
!frontend/scripts/
!frontend/scripts/check-source.mjs
!frontend/scripts/check-bundle.mjs
