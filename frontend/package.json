{
  "name": "zone-laboratory",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:quality": "node --test scripts/quality.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:browser:modes": "node scripts/smoke-modes.mjs",
    "test:browser:arena": "node scripts/smoke-arena.mjs",
    "test:browser:workspace": "node scripts/smoke-workspace.mjs",
    "test:browser:experience": "node scripts/smoke-experience.mjs"
  },
  "dependencies": {
    "katex": "0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
