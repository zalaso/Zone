include LICENSE README.md pyproject.toml
include CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md CHANGELOG.md ROADMAP.md
include constraints-ci.txt Dockerfile compose.yaml .dockerignore .gitignore
recursive-include hidden_lab *.py
recursive-include tests *.py
recursive-include tools *.py
recursive-include docs *.md
recursive-include .github *.md *.yml
include examples/operator-world.json examples/request.json examples/manual-session.txt examples/simulated-operator-input.txt
include frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/index.html frontend/tsconfig.json frontend/vite.config.ts
recursive-include frontend/src *.ts *.tsx *.css
recursive-include frontend/scripts *.mjs
global-exclude *.pyc *.db *.sqlite *.sqlite3 *.private.json .env .env.*
prune benchmark_data
prune benchmark_private
prune benchmark_runs
prune sessions
prune frontend/node_modules
prune frontend/dist
prune .venv
